const { init } = require('./globalPolyfillHelper.js');
const { test } = require('zora');

const sandboxScripts = '../../libexec/sandbox/'

const files = [
  require.resolve(sandboxScripts + 'script-load-wrapper.js'),
  require.resolve(sandboxScripts + 'timer-classes.js'),
  require.resolve(sandboxScripts + 'event-loop-virtualization.js'),
  require.resolve(sandboxScripts + 'timed-promise.js'),
]

const mustLoadScripts = {
  'script-load-wrapper': false,
  'timer-classes': false,
  'event-loop-virtualization': false,
  'timed-promise': false,
}


function onLoad(message)
{
  if (message.value.script in mustLoadScripts)
    mustLoadScripts[message.value.script] = true;
}

init(files, onLoad);

for (const script in mustLoadScripts)
  if (!mustLoadScripts[script])
    process.exit(1)

// everything above is just a long song and dance to get set up
test('immediately-fulfilled', (t) => {
  return new Promise((resolve) => resolve(42))
    .then(() => t.ok(true));
});

test('eventually-fulfilled', (t) => {
  return new Promise((resolve) => setTimeout(() => resolve(42)))
    .then(() => t.ok(true));
});

test('resolve-with-value', (t) => {
  return Promise.resolve(42)
    .then(() => t.ok(true));
});

test('resolve-with-another-promise', async (t) => {
  await Promise.resolve(new Promise((resolve) => resolve(42)));
  return t.ok(true);
});

test('immediately-rejected', (t) => {
  return new Promise((_resolve, reject) => reject(42))
    .catch(() => t.ok(true));
});

test('eventually-rejected', (t) => {
  return new Promise((_resolve, reject) => setTimeout(() => reject(42)))
    .catch(() => t.ok(true));
});

test('await with rejected promise converts to throw', async (t) => {
  try {
    await new Promise((_resolve, reject) => reject(3));
    t.ok(false);
  } catch (e) {
    t.eq(e, 3);
  }
});
